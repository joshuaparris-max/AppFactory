# AppFactory Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local - it contains real secrets

# Application
NODE_ENV=development
ENVIRONMENT=development
APP_NAME=AppFactory
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Server
PORT=3000
HOST=localhost

# Database (if using)
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/appfactory_dev
# Example for SQLite:
# DATABASE_URL=file:./dev.db

DATABASE_URL=postgresql://user:password@localhost:5432/appfactory_dev

# API Keys (if needed)
# API_KEY_PROVIDER_A=your_api_key_here
# API_KEY_PROVIDER_B=your_api_key_here

# Authentication (if using)
# JWT_SECRET=your_jwt_secret_here
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret

# External Services (if needed)
# SENTRY_DSN=https://your-sentry-dsn
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# Email (if needed)
# SENDGRID_API_KEY=your_sendgrid_key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Features (enable/disable features)
# FEATURE_NEW_UI=true
# FEATURE_ANALYTICS=false

# Debug
DEBUG=false
VERBOSE=false

# Add your application-specific variables below:
# CUSTOM_VARIABLE=value
